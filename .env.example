# Supabase — copier vers .env et remplir depuis Project Settings → API
# Ne jamais committer .env

SUPABASE_URL=https://leezsypadtvypdgqgvtk.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentification éditeur (côté serveur / Edge Functions uniquement)
# Générer le secret : openssl rand -base64 32
CATALOGUE_EDITOR_SECRET=
# Mots de passe forts distincts pour chaque profil
CATALOGUE_EDITOR_PASSWORD_ARTIST=
CATALOGUE_EDITOR_PASSWORD_ADMIN=
# Legacy (optionnel) : accepté comme mot de passe admin et comme secret de secours
# CATALOGUE_EDITOR_TOKEN=MS75

# Pour l’éditeur en ligne : copier SUPABASE_ANON_KEY dans media/collectors-config.json → anonKey
